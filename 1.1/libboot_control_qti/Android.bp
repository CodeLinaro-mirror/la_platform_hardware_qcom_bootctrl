cc_library {
    name: "libboot_control_qti",
    vendor: true,
    recovery_available: true,
    shared_libs: [
        "android.hardware.boot@1.1",
        "librecovery_updater",
        "libbase",
        "libcutils",
        "liblog",
        "libz",
    ],
    static_libs: [
        "libboot_control",
        "libbootloader_message_vendor",
        "libfstab",
    ],
    owner: "qti",
    cflags: [
        "-Wall",
        "-Werror",
    ],
    srcs: [
        "libboot_control_qti.cpp",
    ],
    export_include_dirs: ["."],
    defaults : ["bootctl_shrm_config"],
}

soong_config_module_type {
    name: "bootctl_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "bootctl.qti",
    bool_variables: ["skip_shrm_check"],
    properties: ["cflags"],
}

bootctl_cc_defaults {
    name: "bootctl_shrm_config",
    soong_config_variables: {
        skip_shrm_check: {
           cflags : ["-DBOOTCTL_SKIP_SHRM_PTN_CHECK"],
        },
    },
}
